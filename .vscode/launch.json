{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LyriKana: Backend Terminal",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\run-backend.ps1\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "LyriKana: Extension Watch Terminal",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\run-extension.ps1\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "LyriKana: Analysis Worker Terminal",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\run-analysis-worker.ps1\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "LyriKana: Electron Overlay Terminal",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\run-electron.ps1\"",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "LyriKana: Full Development",
      "configurations": [
        "LyriKana: Backend Terminal",
        "LyriKana: Analysis Worker Terminal",
        "LyriKana: Extension Watch Terminal",
        "LyriKana: Electron Overlay Terminal"
      ],
      "stopAll": true
    }
  ]
}
