{
  "manifest_version": 3,
  "name": "LyriKana",
  "version": "0.1",
  "description": "YouTube Music lyrics and pronunciation helper",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lyrikana-furigana-worker.kimchaejun1010.workers.dev/*"
  ], 
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["vendor/kuromoji.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/*"],
      "matches": ["<all_urls>"]
    }
  ]
}