APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./lyrikana.db
LRCLIB_BASE_URL=https://lrclib.net
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,https://music.youtube.com
LOG_LEVEL=INFO
LRCLIB_TIMEOUT_SECONDS=10
VITE_BACKEND_URL=http://127.0.0.1:8000
LYRIKANA_BACKEND_URL=http://127.0.0.1:8000

# Karaoke analysis worker. Uploaded audio must be supplied by the user with permission.
ANALYSIS_DATA_DIR=backend/.analysis-data
ANALYSIS_MODEL_DIR=backend/.analysis-data/models
ANALYSIS_FFMPEG_DIR=backend/.analysis-tools
ANALYSIS_MAX_UPLOAD_BYTES=786432000
ANALYSIS_SEPARATOR=auto
ANALYSIS_SEPARATOR_COMMAND=audio-separator
ANALYSIS_SEPARATOR_MODEL=UVR-MDX-NET-Inst_HQ_3.onnx
ANALYSIS_DEMUCS_MODEL=htdemucs
ANALYSIS_DEVICE=cuda
ANALYSIS_ALIGNER=auto
# JSON array or command template containing {audio}, {request}, and {output}.
ANALYSIS_ALIGNER_COMMAND=
ANALYSIS_CTC_PYTHON=backend/.venv-analysis/Scripts/python.exe
ANALYSIS_CTC_SCRIPT=backend/aligners/japanese_ctc_aligner.py
ANALYSIS_CTC_MODEL=prj-beatrice/japanese-hubert-base-phoneme-ctc-v4
ANALYSIS_CTC_CACHE_DIR=backend/.analysis-data/huggingface
ANALYSIS_CTC_MAX_PATHS=8
ANALYSIS_CTC_CHUNK_SECONDS=25
ANALYSIS_MFA_COMMAND=mfa
ANALYSIS_MFA_DICTIONARY=japanese_mfa
ANALYSIS_MFA_ACOUSTIC_MODEL=japanese_mfa
ANALYSIS_MFA_G2P_MODEL=japanese_mfa
ANALYSIS_COMMAND_TIMEOUT_SECONDS=7200
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_WORKER_LEASE_SECONDS=900
ANALYSIS_WORKER_MAX_ATTEMPTS=3
ANALYSIS_LOW_CONFIDENCE_THRESHOLD=0.55
